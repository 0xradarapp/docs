{
  "openapi": "3.1.0",
  "info": {
    "title": "0xRadar API",
    "description": "Multi-chain wallet intelligence platform — portfolio aggregation, DeFi position monitoring, sweep cost calculation, and token risk scoring across 7+ EVM chains.\n\n**Features:**\n- Real-time multi-chain balance aggregation (parallel `asyncio` fetch)\n- Token metadata enrichment (symbol, name, decimals, logo)\n- CoinGecko USD price integration\n- Sweep consolidation cost calculator (unique differentiator vs DeBank/Zerion)\n- Token risk scoring\n\n**Authentication:** Optional `X-API-Key` header for higher rate limits. Pro tier required for admin endpoints.",
    "version": "0.3.0",
    "contact": {
      "name": "0xRadar Team",
      "email": "volkanglm@gmail.com",
      "url": "https://0xradar.app"
    },
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "x-logo": {
      "url": "https://0xradar.app/favicon.svg"
    }
  },
  "servers": [
    {
      "url": "https://api.0xradar.app",
      "description": "Production (Frankfurt)"
    },
    {
      "url": "https://staging-api.0xradar.app",
      "description": "Staging"
    }
  ],
  "tags": [
    {
      "name": "System",
      "description": "Health check, service info, and chain metadata",
      "x-displayName": "System"
    },
    {
      "name": "Wallet",
      "description": "Wallet balances and portfolio across chains",
      "x-displayName": "Wallet"
    },
    {
      "name": "Sweep",
      "description": "Sweep consolidation quote — calculate cost to consolidate dust/wallet assets to a single chain",
      "x-displayName": "Sweep"
    },
    {
      "name": "Admin",
      "description": "Admin-only endpoints (pro tier API key required)",
      "x-displayName": "Admin"
    }
  ],
  "security": [],
  "paths": {
    "/": {
      "get": {
        "tags": ["System"],
        "summary": "Service info",
        "description": "Returns basic service metadata and available endpoints. No authentication required.",
        "operationId": "getServiceInfo",
        "security": [],
        "responses": {
          "200": {
            "description": "Service information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServiceInfo"
                },
                "examples": {
                  "production": {
                    "summary": "Production response",
                    "value": {
                      "app": "0xRadar API",
                      "version": "0.3.0",
                      "docs": "/docs",
                      "endpoints": {
                        "health": "/v1/health",
                        "wallet_balances": "/v1/wallet/{address}/balances?chain={chain}",
                        "wallet_portfolio": "/v1/wallet/{address}/portfolio",
                        "sweep_quote": "/v1/sweep-quote/{address}"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
