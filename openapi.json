    "/v1/wallet/{address}/balances": {
      "get": {
        "tags": ["Wallet"],
        "summary": "Get wallet balances on a single chain",
        "description": "Fetches native + ERC-20 token balances for an EVM address on a specific chain. Includes USD values when `include_prices=true`. Results are cached for 5 minutes.\n\n**Free tier:** max 10 tokens returned. **Dev/Pro:** up to 200.",
        "operationId": "getWalletBalances",
        "security": [
          {},
          { "ApiKeyAuth": [] }
        ],
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "description": "EVM wallet address (0x prefix, 42 characters)",
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$",
              "example": "0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"
            }
          },
          {
            "name": "chain",
            "in": "query",
            "required": false,
            "description": "Chain ID to query",
            "schema": {
              "type": "string",
              "enum": ["ethereum", "arbitrum", "base", "optimism", "polygon", "hyperevm", "bsc"],
              "default": "ethereum",
              "example": "ethereum"
            }
          },
          {
            "name": "include_prices",
            "in": "query",
            "required": false,
            "description": "Whether to include USD price and value calculations",
            "schema": {
              "type": "boolean",
              "default": true,
              "example": true
            }
          },
          {
            "name": "max_tokens",
            "in": "query",
            "required": false,
            "description": "Maximum number of ERC-20 tokens to return (free: max 10, paid: max 200)",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 20,
              "example": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Wallet balances on the requested chain",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalancesResponse"
                },
                "examples": {
                  "vitalikEthereum": {
                    "summary": "Vitalik's Ethereum wallet",
                    "value": {
                      "address": "0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045",
                      "chain": "ethereum",
                      "chain_info": {
                        "name": "Ethereum",
                        "chain_id": 1,
                        "explorer": "https://etherscan.io"
                      },
                      "native": {
                        "symbol": "ETH",
                        "balance": "5.68",
                        "price_usd": "2061.15",
                        "value_usd": "11706.32"
                      },
                      "tokens": [
                        {
                          "contract": "0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48",
                          "symbol": "USDC",
                          "name": "USD Coin",
                          "decimals": 6,
                          "logo": null,
                          "balance": "1500.0",
                          "balance_raw": "1500000000",
                          "price_usd": "1.00",
                          "value_usd": "1500.0"
                        }
                      ],
                      "token_count_total": 5,
                      "token_count_shown": 5,
                      "total_value_usd": "13206.32",
                      "timestamp": "2026-05-27T06:38:15.395077"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid address or unsupported chain",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "examples": {
                  "invalidAddress": {
                    "summary": "Invalid address format",
                    "value": {
                      "detail": "Invalid EVM address (expected 0x... 42 chars)",
                      "code": "invalid_address"
                    }
                  },
                  "unsupportedChain": {
                    "summary": "Chain not supported",
                    "value": {
                      "detail": "Unsupported chain 'solana'. Available: ethereum, arbitrum, base, optimism, polygon, hyperevm, bsc",
                      "code": "unsupported_chain"
                    }
                  }
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/RateLimited"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/v1/wallet/{address}/portfolio": {
      "get": {
        "tags": ["Wallet"],
        "summary": "Get multi-chain portfolio",
        "description": "Fetches wallet balances across multiple chains in parallel. Returns aggregated totals and per-chain breakdowns. Results are cached for 5 minutes.\n\n**Free tier:** max 3 chains per request. **Dev/Pro:** up to 20 chains.",
        "operationId": "getWalletPortfolio",
        "security": [
          {},
          { "ApiKeyAuth": [] }
        ],
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "description": "EVM wallet address (0x prefix, 42 characters)",
            "schema": {
              "type": "string",
              "pattern": "^0x[a-fA-F0-9]{40}$",
              "example": "0xd8dA6BF26964aF9D7eEd9e03E53415D37aA96045"
            }
          },
          {
            "name": "chains",
            "in": "query",
            "required": false,
            "description": "Comma-separated chain IDs. Default: all supported chains. Free tier limits to 3.",
            "schema": {
              "type": "string",
              "example": "ethereum,base,arbitrum"
            }
          },
          {
            "name": "include_prices",
            "in": "query",
            "required": false,
            "description": "Whether to include USD price and value calculations",
            "schema": {
              "type": "boolean",
              "default": true,
              "example": true
            }
          },
          {
            "name": "max_tokens_per_chain",
            "in": "query",
            "required": false,
            "description": "Maximum tokens returned per chain",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Multi-chain portfolio with per-chain breakdown",
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
